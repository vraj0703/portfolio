app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Written when a golden comparison fails: the two images and the diff
# between them. Useful while looking at one, meaningless once it is fixed.
# The reference images under goldens/ are NOT ignored — they are what the
# test asserts, so they belong in the repository like any other expectation.
test/**/failures/
